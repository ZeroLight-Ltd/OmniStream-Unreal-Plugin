// Composites 6 perspective cube faces (captured by USceneCaptureComponent2D, optionally with
// overscan) into an equirectangular panorama. The equirect is in "rig" space (the capture rig's
// orientation), so face selection is done against fixed axes; the per-face world(rig)-space basis
// vectors are supplied so projection matches exactly how each face camera was oriented in C++.

#include "/Engine/Private/Common.ush"

// 6 faces x (forward, right, up) = 18 vec4 (xyz used).
float4 FaceBasis[18];
// Effective tan(halfFOV) of each captured face = (1 + overscan) (base FOV is 90deg => tan(45)=1).
float OverscanTan;
float2 OutputExtent;

Texture2D Face0;
Texture2D Face1;
Texture2D Face2;
Texture2D Face3;
Texture2D Face4;
Texture2D Face5;
SamplerState FaceSampler;

float3 GetFwd(int f)   { return FaceBasis[f * 3 + 0].xyz; }
float3 GetRight(int f) { return FaceBasis[f * 3 + 1].xyz; }
float3 GetUp(int f)    { return FaceBasis[f * 3 + 2].xyz; }

float4 SampleFace(int f, float2 uv)
{
	if (f == 0) return Face0.SampleLevel(FaceSampler, uv, 0);
	if (f == 1) return Face1.SampleLevel(FaceSampler, uv, 0);
	if (f == 2) return Face2.SampleLevel(FaceSampler, uv, 0);
	if (f == 3) return Face3.SampleLevel(FaceSampler, uv, 0);
	if (f == 4) return Face4.SampleLevel(FaceSampler, uv, 0);
	return Face5.SampleLevel(FaceSampler, uv, 0);
}

void MainPS(
	in float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	// Equirect mapping: x -> longitude [-PI, PI], y -> latitude [+PI/2 (top), -PI/2 (bottom)].
	float2 uv = SvPosition.xy / OutputExtent;
	float Theta = (uv.x * 2.0 - 1.0) * PI;
	float Phi = (0.5 - uv.y) * PI;

	float CosPhi = cos(Phi);
	// Rig space: X forward, Y right, Z up (matches FVector / FRotator basis used C++ side).
	float3 Dir = float3(CosPhi * cos(Theta), CosPhi * sin(Theta), sin(Phi));

	// Pick the face whose optical axis is closest to Dir (largest forward projection), i.e. the
	// face that sees this direction most centrally. With overscan the faces overlap, so this yields
	// a clean cube-seam selection.
	int BestFace = 0;
	float BestFwd = -1.0;
	for (int f = 0; f < 6; ++f)
	{
		float Fwd = dot(Dir, GetFwd(f));
		if (Fwd > BestFwd)
		{
			BestFwd = Fwd;
			BestFace = f;
		}
	}

	float LocalFwd = max(dot(Dir, GetFwd(BestFace)), 1e-4);
	float LocalRight = dot(Dir, GetRight(BestFace));
	float LocalUp = dot(Dir, GetUp(BestFace));

	// Project onto the face plane, normalise by the overscanned half-FOV tangent, then to [0,1] uv.
	float S = (LocalRight / LocalFwd) / OverscanTan;
	float T = (LocalUp / LocalFwd) / OverscanTan;
	S = clamp(S, -1.0, 1.0);
	T = clamp(T, -1.0, 1.0);

	float2 FaceUV = float2(0.5 + 0.5 * S, 0.5 - 0.5 * T);
	OutColor = SampleFace(BestFace, FaceUV);
	OutColor.a = 1.0;
}
